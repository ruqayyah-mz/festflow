# FestFlow Supabase & Deployment Config
# Built in collaboration with Code Questers

# Connect your Supabase project (from Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Set to 'true' to force mock demo storage mode even if keys exist
VITE_USE_MOCK_DATA=false
