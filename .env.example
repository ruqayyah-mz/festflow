# FestFlow Supabase & Deployment Config
# Built in collaboration with Code Questers

# Connect your Supabase project (from Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Set to 'true' to force mock demo storage mode even if keys exist
VITE_USE_MOCK_DATA=false

# Browser push notifications (Web Push). Generate a key pair with: npx web-push generate-vapid-keys
# The PUBLIC key goes here; the PRIVATE key is set on the edge function (see docs/VOLUNTEER_WIDGET_SETUP.md).
VITE_VAPID_PUBLIC_KEY=
